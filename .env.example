# Copy this file to .env.local and replace the placeholder values.
# Keep secret values server-side. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is
# intentionally public and is safe to expose to the browser.

# Sign-in mode. "access-code" uses the preset codes below and only serves
# localhost. "clerk" (the default when unset) uses Clerk.
AUTH_MODE=access-code
ACCESS_CODE_ADMIN=replace_with_the_admin_access_code
ACCESS_CODE_DEVELOPER=replace_with_the_developer_access_code
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Clerk authentication (only used when AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Kyron Public API
KYRON_API_KEY=replace_with_your_kyron_api_key
KYRON_API_BASE_URL=https://app.kyronlearning.com/api/v2

# Kyron MCP (development sign-in). See README.md for hosting the client file.
KYRON_MCP_URL=https://www.kyronlearning.com/mcp
KYRON_OAUTH_CLIENT_ID=replace_with_the_https_url_of_your_hosted_kyron_client_json
APP_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_a_random_base64_32_byte_key
# Optional comma-separated tools the explorer may run without a read-only hint.
KYRON_MCP_READ_TOOLS=

# AI course setup
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# QA agent. QA records live in Neon; uploaded videos for narration checks are
# kept on local disk under QA_DATA_DIR (default .data/qa/media).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace_with_a_random_worker_secret
# "auto" applies confirmed low-risk fixes; "propose_only" escalates every fix.
QA_AUTONOMY_POLICY=auto
QA_RUN_TOKEN_BUDGET=600000
QA_AUDIT_RATE=0.1
# Defaults to OPENAI_MODEL when empty.
OPENAI_QA_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Model the revision agent uses to write corrections (default gpt-6-luna).
OPENAI_REVISION_MODEL=gpt-6-luna
# Kyron changes made by QA: "off", "test-only" (drafts named "[QA Test] …")
# or "all". Writing also needs a Kyron sign-in with write permission.
QA_KYRON_WRITES=test-only
# Kyron video renders (use Kyron credits): "off", "test-only" or "all".
QA_KYRON_VIDEO=off
# Model spend per course before automated steps stop.
QA_COURSE_BUDGET_USD=1

# Vercel Blob
# Local OIDC credentials are pulled into .env.development.local as described
# in README.md. Do not commit VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=replace_with_your_vercel_blob_store_id
