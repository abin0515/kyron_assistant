# Copy this file to .env.local and replace the placeholder values.
# Keep secret values server-side. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is
# intentionally public and is safe to expose to the browser.

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Kyron Public API
KYRON_API_KEY=replace_with_your_kyron_api_key
KYRON_API_BASE_URL=https://app.kyronlearning.com/api/v2

# AI course setup
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
