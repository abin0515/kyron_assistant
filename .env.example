# Copy this file to .env.local and replace the placeholder values.
# Keep secret values server-side. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is
# intentionally public and is safe to expose to the browser.

# Sign-in mode. "access-code" uses the preset codes below; outside localhost
# both codes must be at least 24 characters. "clerk" (the default when unset)
# uses Clerk.
AUTH_MODE=access-code
ACCESS_CODE_ADMIN=replace_with_the_admin_access_code
ACCESS_CODE_DEVELOPER=replace_with_the_developer_access_code
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Clerk authentication (only used when AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_your_clerk_secret_key

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Kyron Public API
KYRON_API_KEY=replace_with_your_kyron_api_key
KYRON_API_BASE_URL=https://app.kyronlearning.com/api/v2

# Kyron MCP. See README.md for hosting the client file. The sign-in is stored
# encrypted in Neon; KYRON_TOKEN_FILE is only read once to import an older
# file-based sign-in.
KYRON_MCP_URL=https://www.kyronlearning.com/mcp
# Local development only: the https address of a client file hosted elsewhere
# (localhost cannot serve it to Kyron). Leave unset on the deployed site, which
# serves its own at /oauth/kyron-client.json.
KYRON_OAUTH_CLIENT_ID=replace_with_the_https_url_of_your_hosted_kyron_client_json
# Unset on Vercel uses the project's production address.
APP_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_a_random_base64_32_byte_key
# Optional comma-separated tools the explorer may run without a read-only hint.
KYRON_MCP_READ_TOOLS=

# Model calls. With AI_GATEWAY_API_KEY set (Vercel → AI Gateway → API Keys),
# every model call goes through Vercel AI Gateway, pinned to OpenAI; model
# names and reasoning levels stay the same. Without it, calls go to OpenAI
# directly with OPENAI_API_KEY. Audio transcription (uploaded videos only)
# always needs OPENAI_API_KEY.
AI_GATEWAY_API_KEY=replace_with_your_vercel_ai_gateway_key
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# QA agent. QA records live in Neon; uploaded videos for narration checks are
# kept on local disk under QA_DATA_DIR (default .data/qa/media).
# CRON_SECRET authenticates the scheduler: Vercel Cron (vercel.json) sends it
# automatically; locally `npm run qa:worker` uses it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=replace_with_a_random_worker_secret
# "auto" applies every proposed fix (critical findings, answer keys and lesson
# settings included) where QA may write; "propose_only" is an emergency switch
# that saves fixes as proposals for a person instead.
QA_AUTONOMY_POLICY=auto
QA_RUN_TOKEN_BUDGET=600000
QA_AUDIT_RATE=0.1
# Defaults to OPENAI_MODEL when empty.
OPENAI_QA_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Model the revision agent uses to write corrections (default gpt-6-luna).
OPENAI_REVISION_MODEL=gpt-6-luna
# Kyron changes made by QA: "off", "test-only" (drafts named "[QA Test] …")
# or "all". Writing also needs a Kyron sign-in with write permission.
QA_KYRON_WRITES=test-only
# Kyron video renders (use Kyron credits): "off", "test-only" or "all".
QA_KYRON_VIDEO=off
# Model spend per course before automated steps stop.
QA_COURSE_BUDGET_USD=1

# Vercel Blob
# Connect the Blob store to the Vercel project; it then provides these. Pull
# them for local use into .env.development.local as described in README.md
# (`npx vercel env pull .env.development.local --environment=development`).
# Every upload needs BLOB_WEBHOOK_PUBLIC_KEY. Do not commit VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=replace_with_your_vercel_blob_store_id
BLOB_WEBHOOK_PUBLIC_KEY=
