# Copy this file to .env.local and replace the placeholder values.
# All variables are server-only. Never prefix them with NEXT_PUBLIC_.

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Kyron Public API
KYRON_API_KEY=replace_with_your_kyron_api_key
KYRON_API_BASE_URL=https://app.kyronlearning.com/api/v2

# AI course setup
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra

# Temporary identity until application authentication is implemented
TEST_USER_ID=test-user-local
TEST_USER_NAME=Local Developer
TEST_USER_EMAIL=developer@example.test
